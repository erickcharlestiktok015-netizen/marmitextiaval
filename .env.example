# Copie estes nomes para a Vercel (Settings → Environment Variables). Não coloque valores reais aqui.

# Mercado Pago → Suas integrações → sua aplicação → Credenciais de produção → Access Token (APP_USR-...)
MP_ACCESS_TOKEN=

# Mercado Pago → Suas integrações → sua aplicação → Webhooks → "Assinatura secreta"
MP_WEBHOOK_SECRET=

# Endereço final do site, sem barra no fim (ex.: https://marmitexdatiaval.com.br)
SITE_URL=

# Opcional: nome que aparece na fatura do cartão (até 13 letras)
MP_STATEMENT_DESCRIPTOR=TIAVAL

# Opcional: "true" para usar o modo de teste do Mercado Pago com credenciais de teste
MP_USE_SANDBOX=false
